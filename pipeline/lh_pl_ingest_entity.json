{
	"name": "lh_pl_ingest_entity",
	"properties": {
		"description": "Child pipeline: land + bronze + silver for ONE entity. Routes on entity.source_type (GCS today; ADLS inbound and OIC REST are the phase-2 paths). Each case is a single wildcard Copy limited to the window [watermark_ts, pipeline_start), so no per-file loop is needed (ADF does not allow a ForEach inside a Switch) and the next run starts exactly where this one ended. Then Databricks bronze, silver, watermark, archive, log.",
		"activities": [
			{
				"name": "Route By Source Type",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.entity.source_type",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "GCS",
							"activities": [
								{
									"name": "Copy GCS To Landing",
									"description": "Binary copy of <source_path>/<file_prefix>*<file_extension> modified in [watermark_ts, pipeline_start) into landing/retail/<entity>/<load_id>/. Auto Loader picks the files up from there.",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.02:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [
										{
											"name": "entity",
											"value": "@{pipeline().parameters.entity.entity_name}"
										},
										{
											"name": "window",
											"value": "@{pipeline().parameters.entity.watermark_ts} -> @{pipeline().parameters.pipeline_start}"
										}
									],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "GoogleCloudStorageReadSettings",
												"recursive": false,
												"wildcardFolderPath": {
													"value": "@pipeline().parameters.entity.source_path",
													"type": "Expression"
												},
												"wildcardFileName": {
													"value": "@concat(pipeline().parameters.entity.file_prefix, '*', pipeline().parameters.entity.file_extension)",
													"type": "Expression"
												},
												"modifiedDatetimeStart": {
													"value": "@pipeline().parameters.entity.watermark_ts",
													"type": "Expression"
												},
												"modifiedDatetimeEnd": {
													"value": "@pipeline().parameters.pipeline_start",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "lh_ds_gcs_bucket",
											"type": "DatasetReference",
											"parameters": {
												"bucket": {
													"value": "@pipeline().parameters.entity.location",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "lh_ds_adls_folder",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(pipeline().parameters.entity.landing_folder, '/', pipeline().parameters.load_id)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Set GCS Files Copied",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Copy GCS To Landing",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "files_copied",
										"value": {
											"value": "@string(coalesce(activity('Copy GCS To Landing').output?.filesWritten, 0))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "ADLS",
							"activities": [
								{
									"name": "Move Inbound To Landing",
									"description": "Files pushed by OIC / an ERP integration into landing/retail/inbound/<entity>/ are moved (copy + delete source) into landing/retail/<entity>/<load_id>/.",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [
										{
											"name": "entity",
											"value": "@{pipeline().parameters.entity.entity_name}"
										}
									],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"wildcardFolderPath": {
													"value": "@pipeline().parameters.entity.source_path",
													"type": "Expression"
												},
												"wildcardFileName": {
													"value": "@concat(pipeline().parameters.entity.file_prefix, '*', pipeline().parameters.entity.file_extension)",
													"type": "Expression"
												},
												"modifiedDatetimeStart": {
													"value": "@pipeline().parameters.entity.watermark_ts",
													"type": "Expression"
												},
												"modifiedDatetimeEnd": {
													"value": "@pipeline().parameters.pipeline_start",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": true
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "lh_ds_adls_container",
											"type": "DatasetReference",
											"parameters": {
												"container": {
													"value": "@pipeline().parameters.entity.location",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "lh_ds_adls_folder",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(pipeline().parameters.entity.landing_folder, '/', pipeline().parameters.load_id)",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Set Inbound Files Copied",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Move Inbound To Landing",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "files_copied",
										"value": {
											"value": "@string(coalesce(activity('Move Inbound To Landing').output?.filesWritten, 0))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"value": "OIC_REST",
							"activities": [
								{
									"name": "Extract From OIC",
									"description": "Phase 2: pull records changed since the watermark from an OIC REST integration (paginated) into a JSON file in landing.",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 1,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:02:00",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"additionalHeaders": {
												"Accept": "application/json"
											},
											"paginationRules": {
												"AbsoluteUrl": "$.links[?(@.rel=='next')].href"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings",
												"filePattern": "setOfObjects"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "lh_ds_oic_rest",
											"type": "DatasetReference",
											"parameters": {
												"relativeUrl": {
													"value": "@concat(pipeline().parameters.entity.source_path, '?updatedSince=', pipeline().parameters.entity.watermark_ts, '&updatedBefore=', pipeline().parameters.pipeline_start)",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "lh_ds_adls_json",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(pipeline().parameters.entity.landing_folder, '/', pipeline().parameters.load_id)",
													"type": "Expression"
												},
												"file": {
													"value": "@concat(pipeline().parameters.entity.file_prefix, formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.json')",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Set OIC Rows Copied",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Extract From OIC",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "files_copied",
										"value": {
											"value": "@concat('rest rows ', string(coalesce(activity('Extract From OIC').output?.rowsCopied, 0)))",
											"type": "Expression"
										}
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Unsupported Source Type",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Unsupported source_type ', pipeline().parameters.entity.source_type, ' for entity ', pipeline().parameters.entity.entity_name)",
									"type": "Expression"
								},
								"errorCode": "UNSUPPORTED_SOURCE"
							}
						}
					]
				}
			},
			{
				"name": "Bronze Ingest",
				"description": "Auto Loader (availableNow) from landing/retail/<entity> into retail_bronze.<entity>.",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Route By Source Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 120,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "entity",
						"value": "@{pipeline().parameters.entity.entity_name}"
					}
				],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/10_ingest/bronze_ingest')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"entity_name": {
							"value": "@pipeline().parameters.entity.entity_name",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().parameters.load_id",
							"type": "Expression"
						},
						"ingest_mode": "autoloader"
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Silver Transform",
				"description": "cast -> DQ (quarantine) -> dedupe -> SCD1/SCD2 MERGE, driven by retail_ops.ctl_entity.",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Bronze Ingest",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "entity",
						"value": "@{pipeline().parameters.entity.entity_name}"
					}
				],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/20_silver/silver_transform')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"entity_name": {
							"value": "@pipeline().parameters.entity.entity_name",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().parameters.load_id",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Watermark",
				"description": "Watermark = pipeline_start, the exclusive upper bound of this run's copy window, so the next run continues exactly where this one stopped. Only reached after silver succeeded.",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Silver Transform",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/50_ops/update_watermark')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"entity_name": {
							"value": "@pipeline().parameters.entity.entity_name",
							"type": "Expression"
						},
						"watermark_ts": {
							"value": "@pipeline().parameters.pipeline_start",
							"type": "Expression"
						},
						"status": "SUCCESS"
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Archive Files",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Update Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/50_ops/archive_landing_files')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"entity_name": {
							"value": "@pipeline().parameters.entity.entity_name",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().parameters.load_id",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Log Entity Success",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Archive Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/50_ops/log_run')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().parameters.load_id",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"entity_name": {
							"value": "@pipeline().parameters.entity.entity_name",
							"type": "Expression"
						},
						"layer": "entity",
						"status": "SUCCESS",
						"rows_read": {
							"value": "@string(activity('Silver Transform').output.runOutput.rows_in)",
							"type": "Expression"
						},
						"rows_written": {
							"value": "@string(activity('Silver Transform').output.runOutput.rows_merged)",
							"type": "Expression"
						},
						"rows_quarantined": {
							"value": "@string(activity('Silver Transform').output.runOutput.rows_quarantined)",
							"type": "Expression"
						},
						"message": {
							"value": "@concat('files=', variables('files_copied'), ' bronze=', string(activity('Bronze Ingest').output.runOutput.rows_ingested), ' watermark=', activity('Update Watermark').output.runOutput.watermark_ts)",
							"type": "Expression"
						},
						"trigger_type": {
							"value": "@pipeline().parameters.trigger_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			}
		],
		"policy": {
			"elapsedTimeMetric": {}
		},
		"parameters": {
			"entity": {
				"type": "object"
			},
			"load_id": {
				"type": "string"
			},
			"catalog": {
				"type": "string",
				"defaultValue": "cs_databricks_muneer"
			},
			"env": {
				"type": "string",
				"defaultValue": "dev"
			},
			"trigger_type": {
				"type": "string",
				"defaultValue": "Manual"
			},
			"pipeline_start": {
				"type": "string"
			},
			"notebook_root": {
				"type": "string",
				"defaultValue": "/Workspace/lakehouse/dev/notebooks"
			}
		},
		"variables": {
			"files_copied": {
				"type": "String",
				"defaultValue": "0"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse"
		]
	}
}
