{
	"name": "lh_pl_master",
	"properties": {
		"description": "Entry point (triggers and manual runs). Thin wrapper around lh_pl_orchestrate so that ONE failure branch covers every step: on failure it logs, sends the failure alert and re-fails, so the run shows red in monitoring.",
		"activities": [
			{
				"name": "Run Orchestration",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "lh_pl_orchestrate",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"load_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"pipeline_start": {
							"value": "@formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:ssZ')",
							"type": "Expression"
						},
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"env": {
							"value": "@pipeline().parameters.env",
							"type": "Expression"
						},
						"source_system": {
							"value": "@pipeline().parameters.source_system",
							"type": "Expression"
						},
						"run_group": {
							"value": "@pipeline().parameters.run_group",
							"type": "Expression"
						},
						"entities": {
							"value": "@pipeline().parameters.entities",
							"type": "Expression"
						},
						"ai_mode": {
							"value": "@pipeline().parameters.ai_mode",
							"type": "Expression"
						},
						"enable_llm": {
							"value": "@pipeline().parameters.enable_llm",
							"type": "Expression"
						},
						"notify": {
							"value": "@pipeline().parameters.notify",
							"type": "Expression"
						},
						"notebook_root": {
							"value": "@pipeline().parameters.notebook_root",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Log Run Failure",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Run Orchestration",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": {
						"value": "@concat(pipeline().parameters.notebook_root, '/50_ops/log_run')",
						"type": "Expression"
					},
					"baseParameters": {
						"catalog": {
							"value": "@pipeline().parameters.catalog",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"entity_name": "ALL",
						"layer": "pipeline",
						"status": "FAILED",
						"message": {
							"value": "@activity('Run Orchestration').error.message",
							"type": "Expression"
						},
						"trigger_type": {
							"value": "@pipeline().TriggerType",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_compute",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Notify Failure",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Log Run Failure",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "lh_pl_notify",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"status": "FAILED",
						"subject": {
							"value": "@concat('[FAILED] ', pipeline().Pipeline, ' run ', substring(pipeline().RunId, 0, 8))",
							"type": "Expression"
						},
						"body_html": {
							"value": "@concat('<h2 style=\"color:#c62828\">', pipeline().Pipeline, ' failed</h2><p>run_id <code>', pipeline().RunId, '</code> triggered by ', pipeline().TriggerType, ' (', pipeline().TriggerName, ')</p><pre>', replace(activity('Run Orchestration').error.message, '<', '&lt;'), '</pre>')",
							"type": "Expression"
						},
						"load_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"enabled": {
							"value": "@pipeline().parameters.notify",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Fail Run",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Notify Failure",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Run Orchestration').error.message",
						"type": "Expression"
					},
					"errorCode": "RUN_FAILED"
				}
			}
		],
		"concurrency": 1,
		"policy": {
			"elapsedTimeMetric": {
				"duration": "0.03:00:00"
			}
		},
		"parameters": {
			"catalog": {
				"type": "string",
				"defaultValue": "cs_databricks_muneer"
			},
			"env": {
				"type": "string",
				"defaultValue": "dev"
			},
			"source_system": {
				"type": "string",
				"defaultValue": "ALL"
			},
			"run_group": {
				"type": "string",
				"defaultValue": "daily"
			},
			"entities": {
				"type": "string",
				"defaultValue": ""
			},
			"ai_mode": {
				"type": "string",
				"defaultValue": "auto"
			},
			"enable_llm": {
				"type": "string",
				"defaultValue": "false"
			},
			"notify": {
				"type": "string",
				"defaultValue": "true"
			},
			"notebook_root": {
				"type": "string",
				"defaultValue": "/Workspace/lakehouse/dev/notebooks"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse"
		]
	}
}
