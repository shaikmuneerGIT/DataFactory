{
	"name": "gcp_to_azure_full_load",
	"properties": {
		"activities": [
			{
				"name": "meta_data lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "job_id",
						"value": "201"
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureDatabricksDeltaLakeSource",
						"query": {
							"value": "@concat('select param.*, control.* from metadata_schema.tbl_source_control as control inner join metadata_schema.tbl_parameters as param on param.job_id = control.job_id where control.job_id = ''', pipeline().parameters.job_id, '''')\n",
							"type": "Expression"
						}
					},
					"dataset": {
						"referenceName": "ds_metadata_adb_deltalake",
						"type": "DatasetReference"
					}
				}
			}
		],
		"annotations": []
	}
}