{
	"name": "gcp_to_azure_full_load",
	"properties": {
		"activities": [
			{
				"name": "metadata_lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureDatabricksDeltaLakeSource",
						"query": {
							"value": "@concat('select p.job_id, p.source_file_path, date_format(p.watermark_column, \"yyyy-MM-dd''T''HH:mm:ss.SSS''Z''\") as watermark_column, p.raw_schema, p.raw_tbl, p.intermediate_schema, p.intermediate_tbl, p.intermediate_query, p.curated_schema, p.curated_tbl, p.curated_query, s.gcp_source_bucket, s.storage_account, s.adls_url, s.container_name, s.logic_app_url, s.email_id from cs_databricks_muneer.metadata_schema.tbl_parameters p cross join cs_databricks_muneer.metadata_schema.tbl_source_control s where p.job_id = ', pipeline().parameters.job_id)\n",
							"type": "Expression"
						}
					},
					"dataset": {
						"referenceName": "ds_metadata_adb_deltalake",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "get_source_file_names",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "metadata_lookup",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_input_gcp",
						"type": "DatasetReference",
						"parameters": {
							"bucket": "csgcpstorage_muneer",
							"folder": "telecom/dim_cities",
							"file": "telecom_dim_cities_20231219.csv"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "GoogleCloudStorageReadSettings",
						"modifiedDatetimeStart": {
							"value": "@concat(activity('metadata_lookup').output.firstRow.watermark_column, 'Z')\n",
							"type": "Expression"
						},
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"job_id": {
				"type": "string",
				"defaultValue": "201"
			}
		},
		"annotations": []
	}
}