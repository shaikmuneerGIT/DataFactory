{
	"name": "lh_pl_mdm_customer_to_fabric",
	"properties": {
		"description": "MDM customer event -> Fabric. Started by lh_tr_mdm_customer_event when OIC drops <mdmCustomerId>-<ts>.json under landing/mdm/customers/inbound/. Copies the file byte-for-byte into the lakehouse Files area (same relative path). The merge into mdm_bronze / mdm_silver is done by the Fabric notebook nb_mdm_customer_merge on its own 15-minute schedule (owner identity): a notebook job started by this factory's service principal fails on this tenant with 'Job failed to start: unable to acquire user token' (2026-10-03), so the pipeline no longer calls it. notebook_name / workspace_id stay as parameters for reference.",
		"activities": [
			{
				"name": "Set Folder In Container",
				"description": "triggerBody().folderPath is 'landing/mdm/customers/inbound/yyyy/MM/dd' (container first); datasets want the path inside the container.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "folder_in_container",
					"value": {
						"value": "@if(contains(pipeline().parameters.folder_path, '/'), substring(pipeline().parameters.folder_path, add(indexOf(pipeline().parameters.folder_path, '/'), 1)), pipeline().parameters.folder_path)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set Lakehouse File",
				"description": "Path of the copied file relative to Files/, passed to the notebook.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set Folder In Container",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "lakehouse_file",
					"value": {
						"value": "@concat(variables('folder_in_container'), '/', pipeline().parameters.file_name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy Event To Lakehouse",
				"description": "Binary copy ADLS landing/<folder>/<file> -> lakehouse Files/<folder>/<file>.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set Lakehouse File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "file",
						"value": "@{pipeline().parameters.file_name}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "LakehouseWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "lh_ds_adls_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.container",
								"type": "Expression"
							},
							"folder": {
								"value": "@variables('folder_in_container')",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "lh_ds_fabric_files",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@variables('folder_in_container')",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"folder_path": {
				"type": "string",
				"defaultValue": "landing/mdm/customers/inbound/2026/09/30"
			},
			"file_name": {
				"type": "string",
				"defaultValue": "MDM-CUST-000481-20260930T120000Z.json"
			},
			"workspace_id": {
				"type": "string",
				"defaultValue": "7d6cf283-5e16-4271-a2c7-d1494b49695f"
			},
			"notebook_name": {
				"type": "string",
				"defaultValue": "nb_mdm_customer_merge"
			}
		},
		"variables": {
			"folder_in_container": {
				"type": "String"
			},
			"lakehouse_file": {
				"type": "String"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse",
			"mdm"
		]
	}
}
