{
	"name": "lh_pl_mdm_customer_to_fabric",
	"properties": {
		"description": "MDM customer event -> Fabric. Started by lh_tr_mdm_customer_event when OIC drops <mdmCustomerId>-<ts>.json under landing/mdm/customers/inbound/. Copies the file byte-for-byte into the lakehouse Files area (same relative path), then runs the Fabric notebook nb_mdm_customer_merge (bronze append + silver MERGE) through the Fabric REST job API and waits for it. Auth for the Fabric calls: service principal spn_adb_to_adls, secret from Key Vault (never in Git).",
		"activities": [
			{
				"name": "Set Folder In Container",
				"description": "triggerBody().folderPath is 'landing/mdm/customers/inbound/yyyy/MM/dd' (container first); datasets want the path inside the container.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "folder_in_container",
					"value": {
						"value": "@if(contains(pipeline().parameters.folder_path, '/'), substring(pipeline().parameters.folder_path, add(indexOf(pipeline().parameters.folder_path, '/'), 1)), pipeline().parameters.folder_path)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set Lakehouse File",
				"description": "Path of the copied file relative to Files/, passed to the notebook.",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set Folder In Container",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "lakehouse_file",
					"value": {
						"value": "@concat(variables('folder_in_container'), '/', pipeline().parameters.file_name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy Event To Lakehouse",
				"description": "Binary copy ADLS landing/<folder>/<file> -> lakehouse Files/<folder>/<file>.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set Lakehouse File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "file",
						"value": "@{pipeline().parameters.file_name}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "LakehouseWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "lh_ds_adls_file",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.container",
								"type": "Expression"
							},
							"folder": {
								"value": "@variables('folder_in_container')",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "lh_ds_fabric_files",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@variables('folder_in_container')",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.file_name",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "List Notebooks",
				"description": "Resolve the notebook id by name so no item id is hard-coded (ids differ per workspace).",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Copy Event To Lakehouse",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat('https://api.fabric.microsoft.com/v1/workspaces/', pipeline().parameters.workspace_id, '/notebooks')",
						"type": "Expression"
					},
					"authentication": {
						"type": "ServicePrincipal",
						"userTenant": "70d48915-9aaa-460f-9616-a32e05fd1a74",
						"username": "fb54154b-f3d6-4c9f-a7e4-f484898ded7e",
						"password": {
							"type": "AzureKeyVaultSecret",
							"store": {
								"referenceName": "ls_AzurekeyVault",
								"type": "LinkedServiceReference"
							},
							"secretName": "spn-secret"
						},
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Filter Notebook",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List Notebooks",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List Notebooks').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().displayName, pipeline().parameters.notebook_name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Run Merge Notebook",
				"description": "POST .../items/<notebook>/jobs/instances?jobType=RunNotebook with the file path and load id as notebook parameters. Fabric answers 202 + Location (the job instance); polled below.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Filter Notebook",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@concat('https://api.fabric.microsoft.com/v1/workspaces/', pipeline().parameters.workspace_id, '/items/', activity('Filter Notebook').output.value[0].id, '/jobs/instances?jobType=RunNotebook')",
						"type": "Expression"
					},
					"headers": {
						"Content-Type": "application/json"
					},
					"body": {
						"value": "@json(concat('{\"executionData\":{\"parameters\":{\"file_path\":{\"value\":\"', variables('lakehouse_file'), '\",\"type\":\"string\"},\"load_id\":{\"value\":\"', pipeline().RunId, '\",\"type\":\"string\"}}}}'))",
						"type": "Expression"
					},
					"disableAsyncPattern": true,
					"authentication": {
						"type": "ServicePrincipal",
						"userTenant": "70d48915-9aaa-460f-9616-a32e05fd1a74",
						"username": "fb54154b-f3d6-4c9f-a7e4-f484898ded7e",
						"password": {
							"type": "AzureKeyVaultSecret",
							"store": {
								"referenceName": "ls_AzurekeyVault",
								"type": "LinkedServiceReference"
							},
							"secretName": "spn-secret"
						},
						"resource": "https://api.fabric.microsoft.com"
					}
				}
			},
			{
				"name": "Until Job Finished",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Run Merge Notebook",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(variables('job_status'), 'Completed'), or(equals(variables('job_status'), 'Failed'), equals(variables('job_status'), 'Cancelled')))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Wait Before Poll",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 20
							}
						},
						{
							"name": "Get Job Status",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Wait Before Poll",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": true
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@activity('Run Merge Notebook').output.ADFWebActivityResponseHeaders.Location",
									"type": "Expression"
								},
								"disableAsyncPattern": true,
								"authentication": {
									"type": "ServicePrincipal",
									"userTenant": "70d48915-9aaa-460f-9616-a32e05fd1a74",
									"username": "fb54154b-f3d6-4c9f-a7e4-f484898ded7e",
									"password": {
										"type": "AzureKeyVaultSecret",
										"store": {
											"referenceName": "ls_AzurekeyVault",
											"type": "LinkedServiceReference"
										},
										"secretName": "spn-secret"
									},
									"resource": "https://api.fabric.microsoft.com"
								}
							}
						},
						{
							"name": "Set Job Status",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Get Job Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "job_status",
								"value": {
									"value": "@string(activity('Get Job Status').output.status)",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.00:30:00"
				}
			},
			{
				"name": "If Notebook Failed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until Job Finished",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(variables('job_status'), 'Completed'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail Merge",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Fabric notebook ', pipeline().parameters.notebook_name, ' ended with status ', variables('job_status'), ' for ', variables('lakehouse_file'), ': ', string(activity('Get Job Status').output.failureReason))",
									"type": "Expression"
								},
								"errorCode": "MDM_FABRIC_MERGE_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"folder_path": {
				"type": "string",
				"defaultValue": "landing/mdm/customers/inbound/2026/09/30"
			},
			"file_name": {
				"type": "string",
				"defaultValue": "MDM-CUST-000481-20260930T120000Z.json"
			},
			"workspace_id": {
				"type": "string",
				"defaultValue": "7d6cf283-5e16-4271-a2c7-d1494b49695f"
			},
			"notebook_name": {
				"type": "string",
				"defaultValue": "nb_mdm_customer_merge"
			}
		},
		"variables": {
			"folder_in_container": {
				"type": "String"
			},
			"lakehouse_file": {
				"type": "String"
			},
			"job_status": {
				"type": "String",
				"defaultValue": "NotStarted"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse",
			"mdm"
		]
	}
}
