{
	"name": "lh_ds_adls_container",
	"properties": {
		"description": "ADLS Gen2 container root (binary). Folder and file are chosen by wildcards in the Copy activity source (inbound files pushed by OIC / ERP).",
		"linkedServiceName": {
			"referenceName": "ls_adls",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "landing"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse",
			"phase-2"
		],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileSystem": {
					"value": "@dataset().container",
					"type": "Expression"
				}
			}
		}
	}
}
