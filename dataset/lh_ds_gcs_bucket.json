{
	"name": "lh_ds_gcs_bucket",
	"properties": {
		"description": "GCS bucket root (binary). Folder and file are chosen by wildcards in the Copy activity source, so the dataset deliberately has no folder or file path.",
		"linkedServiceName": {
			"referenceName": "ls_gcp",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"bucket": {
				"type": "string",
				"defaultValue": "csgcpstorage_muneer"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse"
		],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "GoogleCloudStorageLocation",
				"bucketName": {
					"value": "@dataset().bucket",
					"type": "Expression"
				}
			}
		}
	}
}
