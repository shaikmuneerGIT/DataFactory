{
	"name": "lh_ds_adls_file",
	"properties": {
		"description": "Single file in ADLS Gen2 (binary). Sink of the landing copy; also the source/target for inbound moves.",
		"linkedServiceName": {
			"referenceName": "ls_adls",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse"
		],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().container",
					"type": "Expression"
				}
			}
		}
	}
}
