{
	"name": "lh_ds_adls_file",
	"properties": {
		"description": "One file in the OIC landing account oicmdmlandingmuneer (ADLS Gen2; container + folder + file, binary). Source of the MDM customer event copy to Fabric.",
		"linkedServiceName": {
			"referenceName": "lh_ls_adls_oic",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"folder": {
			"name": "lakehouse-retail"
		},
		"annotations": [
			"lakehouse",
			"mdm"
		],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().container",
					"type": "Expression"
				}
			}
		}
	}
}